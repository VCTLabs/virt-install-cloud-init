#cloud-config
#
# create devel VM host with basic tools and several dev users
# packages like devel config but without jenkins
#
manage_etc_hosts: true
timezone: America/Los_Angeles

package_upgrade: true
package_update: true
packages:
  - openssh-server
  - sudo
  - net-tools
  - bind9-utils
  - ca-certificates
  - gnupg
  - curl
  - nano
  - wget
  - cmake
  - rsync
  - libzip-dev
  - git
  - git-lfs
  - cloud-guest-utils
  - default-jre-headless
  - apt-transport-https
  - apt-utils
  - libbz2-dev
  - libfreetype-dev
  - libjpeg-turbo8-dev
  - libldap2-dev
  - libpng-dev
  - libpq-dev
  - libxslt-dev
  - libxss1
  - nodejs
  - unzip
  - vim
  - zip

ntp:
  enabled: true
  ntp_client: chrony  # Uses cloud-init default chrony configuration

runcmd:
  - update-grub
  - echo UsePAM yes >> /etc/ssh/sshd_config
  - [systemctl, enable, sshd]
  - [systemctl, start, sshd]
  - ufw allow OpenSSH
  - ufw allow 8080
  - ufw enable
  #################################
  # add php and build bits for extension tool
  - DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends php php-bcmath php-zip php-bz2 php-curl php-gd php-json php-mbstring php-pdo-mysql php-xsl php-posix php-simplexml php-tokenizer php-fileinfo php-pgsql php-gd
  # add and enable login manager and Mate
  - DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends mate-desktop-environment lightdm mate-desktop-environment-extras xauth xvfb epiphany-browser
  # Cypress dependencies
  - DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends libgtk2.0-0 libgtk-3-0 libgbm-dev libnotify-dev libnss3 libxss1 libasound2t64 libxtst6
  - dpkg-reconfigure lightdm
  - [systemctl, enable, lightdm]
  # extension tool build deps
  - DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends autoconf automake libtool m4 make gcc php-dev
  # install php extension tool
  - curl -fL --output pie.phar https://github.com/php/pie/releases/latest/download/pie.phar
  - mv pie.phar /usr/local/bin/pie
  - chmod +x /usr/local/bin/pie
  # install latest composer
  - curl -fsSL https://getcomposer.org/installer > composer-setup.php
  - php composer-setup.php --install-dir=/usr/local/bin --filename=composer
  - php -r "unlink('composer-setup.php');"
  # install node like upstream Dockerfile
  - mkdir -p /etc/apt/keyrings
  - curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg
  - echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list
  - apt-get update -qq
  - DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nodejs
  - rm -rf /var/lib/apt/lists/*

