#cloud-config
manage_etc_hosts: true
timezone: America/Los_Angeles

package_upgrade: true
package_update: true
packages:
  - openssh-server
  - sudo
  - net-tools
  - bind9-utils
  - curl
  - wget
  - git
  - git-lfs
  - cloud-guest-utils
  - rauc
  - rauc-service
  - dbus-x11
  - libcurl4
  - vim
  - nano
  - tmux
  - build-essential
  - dkms
  - linux-headers
  - ninja-build
  - libx11-dev
  - libudev-dev
  - pkg-config
  - libblkid-dev
  - libsystemd-dev
  - libfontconfig-dev
  - dotnet-sdk-10.0
  - libxrandr-dev
  - libgl1-mesa-dev
  - libsamplerate0-dev
  - libasound2-dev
  - libatopology-dev
  - libopenjp2-7
  - libopenjp2-7-dev
  - libdecor-0-dev
  - libpulse-dev
  - libx264-dev
  - libxss-dev
  - libxi-dev
  - cmake
  - zip
  # see below for mate-desktop setup

ntp:
  enabled: true
  ntp_client: chrony  # Uses cloud-init default chrony configuration

runcmd:
  - echo UsePAM yes >> /etc/ssh/sshd_config
  - [systemctl, enable, sshd]
  - [systemctl, start, sshd]
  - sed -i 's|IPV6=yes|IPV6=no|' /etc/default/ufw
  - ufw allow OpenSSH
  #- ufw allow 8080
  - ufw enable
  # install cuda sdk
  - wget https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/x86_64/cuda-keyring_1.1-1_all.deb
  - dpkg -i cuda-keyring_1.1-1_all.deb
  - apt update
  - apt install -y cuda-toolkit-13-2
  # add and enable login manager and Mate
  - apt install -y mate-desktop-environment lightdm
  - dpkg-reconfigure lightdm
  - [systemctl, enable, lightdm]

